(pprint-coalton-codegen-types
  (inline)
  (monomorphize)
  (declare next-ufix-src (Void -> Parser String UFix :r UFix))
  (define (next-ufix-src)
    (next-ufix)))
(cl:disassemble next-ufix)
;; (cl:disassemble (next-ufix)) - Errors because it needs source dictionary
(cl:disassemble (next-ufix-src))
