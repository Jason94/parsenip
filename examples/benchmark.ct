(cl:defpackage #:parsenip/examples/benchmark
  (:use
   #:coalton
   #:coalton-prelude
   #:coalton/math/integral
   #:parsenip/sources
   #:parsenip
   #:parsenip/text)
  (:local-nicknames
   (:ch #:coalton/char)
   (:la #:coalton/lisparray)
   (:fl #:coalton/file)
   )
  (:export
   #:run-bench))

(cl:in-package #:parsenip/examples/benchmark)

(cl:declaim (cl:optimize (cl:speed 3) (cl:debug 0) (cl:safety 1)))

(named-readtables:in-readtable coalton:coalton)

;; See: https://gitlab.com/FinnBender/haskell-parsing-benchmarks

;; SUM   = SUM '+' PROD
;;       | SUM '-' PROD
;;       | PROD

;; PROD  = PROD '*' ATOM
;;       | PROD '/' ATOM
;;       | ATOM

;; ATOM  = integer
;;       | '(' SUM ')'

(coalton-toplevel
  (derive Eq)
  (define-type Expr
    (Bin Op Expr Expr)
    (Atom UFix))

  (repr :enum)
  (derive eq)
  (define-type Op
    Add Sub Mul Divd))

(coalton-toplevel
  (inline)
  (define (lexeme p)
    (take-left p (skip-ws)))
  
  (inline)
  (define (sum-op)
    (lexeme
     (alt (literal-string "+" ƒab.(Bin Add a b))
          (literal-string "-" ƒab.(Bin Sub a b)))))

  (inline)
  (define (prod-op)
    (lexeme
     (alt (literal-string "*" ƒab.(Bin Mul a b))
          (literal-string "/" ƒab.(Bin Divd a b)))))
  
  (inline)
  (define (sum_)
    (chainl1 (prod) (sum-op)))
    
  (inline)
  (define (prod)
    (chainl1 (atm) (prod-op)))
  
  (inline)
  (define (atm)
    (alt (lexeme (map Atom (next-ufix)))
         (do
          (lexeme (next-token #\())
          (ex <- (sum_))
          (lexeme (next-token #\)))
          (pure ex)))) 

  (inline)
  (declare parse-expr (Source :s :c Char => Void -> Parser :s :c :r Expr))
  (define (parse-expr)
    (take-left (sum_) (eof)))

  (monomorphize)
  (declare parse-expr-file (String -> ParseResult UFix Expr))
  (define (parse-expr-file filename)
    (let f =
      (fn (fs)
        (parse-file-chars! fs (parse-expr))))
    (match 
        (fl:with-open-file filename
          (fn (fs)
            (Ok (f fs))))
      ((Err _)
       (error ""))
      ((Ok x)
       x)))
  )

(cl:defun run-bench (filename)
  (cl:print "timing...")
  (cl:time (coalton (parse-expr-file
                     (lisp (-> String) ()
                       filename))))
  (cl:print "profiling...")
  (flamegraph:save-flame-graph ("bench.stack")
    (coalton (parse-expr-file
              (lisp (-> String) ()
                filename))))
  (cl:values))

;;;
;;; Bulk-read version
;;;

(coalton-toplevel
  (monomorphize)
  (declare parse-expr-file-bulk (String -> ParseResult UFix Expr))
  (define (parse-expr-file-bulk filename)
    (let tokens =
      (lisp (-> String) (filename)
        (cl:with-open-file (fs filename :direction :input)
          (cl:let ((buffer (cl:make-string (cl:file-length fs))))
            (cl:read-sequence buffer fs)
            buffer))))
    (parse-source tokens (parse-expr))))
  
(cl:defun run-bench-bulk (filename)
  (cl:print "timing...")
  (cl:time (coalton (parse-expr-file-bulk
                     (lisp (-> String) ()
                       filename))))
  (cl:print "profiling...")
  (flamegraph:save-flame-graph ("bench-bulk.stack")
    (coalton (parse-expr-file-bulk
              (lisp (-> String) ()
                filename))))
  (cl:values))

;; (cl:disassemble parse-expr-file-bulk)
;;

(coalton-toplevel
  (inline)
  (monomorphize)
  (declare pegged-atm (Void -> Parser String UFix :r Expr))
  (define (pegged-atm)
    (atm)))
           
(cl:disassemble #'parsenip/text::next-ufix-loop)
(cl:disassemble (coalton (pegged-atm)))
(cl:let ((step-function
           (coalton
             (the
              (String * UFix
                      -> (Optional Char) * (Optional UFix))
              step))))
  (cl:format cl:t "~&Target: ~S~%"
             (sb-kernel:%fun-name
              (sb-kernel:%fun-fun step-function)))
  (cl:disassemble step-function))

(coalton-toplevel
  (inline)
  (monomorphize)
  (declare pegged-next-ufix (Void -> Parser String UFix :r UFIx))
  (define (pegged-next-ufix)
    (next-ufix))
  
  (inline)
  (monomorphize)
  (declare pegged-next-ufix-lp (String * UFix * UFix -> UFix * UFix))
  (define (pegged-next-ufix-lp s c x)
    (let (values t? c?) = (step s c))
    (match t?
      ((None)
       (values c x))
      ((Some t)
       (match (ch:digit->ufix t)
         ((None)
          (values c x))
         ((Some d)
          (match c?
            ((None)
             (values c x))
            ((Some c)
             (pegged-next-ufix-lp s c (+ (* 10 x) d))))))))))

(cl:disassemble (coalton (pegged-next-ufix)))
(cl:disassemble pegged-next-ufix-lp)
;; (cl:disassemble NEXT-UFIX-LOOP#11902)

(coalton-toplevel
  (monomorphize)
  (declare pegged-parse-expr (Void -> Parser String UFix :r Expr))
  (define (pegged-parse-expr)
    (parse-expr)))

(cl:disassemble (coalton (pegged-parse-expr)))

(coalton-toplevel
  (monomorphize)
  (declare pegged-sum (Void -> Parser String UFix :r Expr))
  (define (pegged-sum)
    (sum_)))

(cl:disassemble (coalton (pegged-sum)))

(coalton-toplevel
  (monomorphize)
  (declare pegged-prod
    (Void -> Parser String UFix :r Expr))
  (define (pegged-prod)
    (prod)))

(cl:disassemble (coalton (pegged-prod)))
;; (cl:disassemble next-ufix-loop#14998)
