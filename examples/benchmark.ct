(cl:defpackage #:parsenip/examples/benchmark
  (:use
   #:coalton
   #:coalton-prelude
   #:coalton/math/integral
   #:parsenip/sources
   #:parsenip
   #:parsenip/text)
  (:local-nicknames
   (:fl #:coalton/file)
   )
  (:export
   #:run-bench))

(cl:in-package #:parsenip/examples/benchmark)

(cl:declaim (cl:optimize (cl:speed 3) (cl:debug 0) (cl:safety 1)))

(named-readtables:in-readtable coalton:coalton)

;; See: https://gitlab.com/FinnBender/haskell-parsing-benchmarks

;; SUM   = SUM '+' PROD
;;       | SUM '-' PROD
;;       | PROD

;; PROD  = PROD '*' ATOM
;;       | PROD '/' ATOM
;;       | ATOM

;; ATOM  = integer
;;       | '(' SUM ')'

(coalton-toplevel
  (derive Eq)
  (define-type Expr
    (Bin Op Expr Expr)
    (Atom UFix))

  (repr :enum)
  (derive eq)
  (define-type Op
    Add Sub Mul Divd))

(coalton-toplevel
  (inline)
  (define (lexeme p)
    (take-left p (skip-ws)))
  
  (inline)
  (define (sum-op)
    (lexeme
     (alt (literal "+" ƒab.(Bin Add a b))
          (literal "-" ƒab.(Bin Sub a b)))))

  (inline)
  (define (prod-op)
    (lexeme
     (alt (literal "*" ƒab.(Bin Mul a b))
          (literal "/" ƒab.(Bin Divd a b)))))
  
  (inline)
  (define (sum_)
    (chainl1 (prod) (sum-op)))
    
  (inline)
  (define (prod)
    (chainl1 (atm) (prod-op)))
  
  (inline)
  (define (atm)
    (alt (lexeme (map Atom (next-ufix)))
         (do
          (lexeme (next-token #\())
          (ex <- (sum_))
          (lexeme (next-token #\)))
          (pure ex)))) 

  (inline)
  (declare parse-expr (Source :s :c Char => Void -> Parser :s :c :r Expr))
  (define (parse-expr)
    (take-left (sum_) (eof)))

  (monomorphize)
  (declare parse-expr-file (String -> ParseResult UFix Expr))
  (define (parse-expr-file filename)
    (match 
        (fl:with-open-file filename
          (fn (fs)
            (Ok (parse-file-chars! fs
                                   (parse-expr)))))
      ((Err _)
       (error ""))
      ((Ok x)
       x)))
  )

(cl:defun run-bench (filename)
  (cl:print "timing...")
  (cl:time (coalton (parse-expr-file
                     (lisp (-> String) ()
                       filename))))
  (cl:print "profiling...")
  (flamegraph:save-flame-graph ("bench.stack")
    (coalton (parse-expr-file
              (lisp (-> String) ()
                filename))))
  (cl:values))

(coalton-toplevel
  (monomorphize)
  (declare parse-expr-file_ (fl:FileStream Char -> ParseResult UFix Expr))
  (define (parse-expr-file_ fs)
    (parse-file-chars! fs (parse-expr))))

