(cl:defpackage #:parsenip/text
  (:use
   #:coalton
   #:coalton-prelude
   #:parsenip/sources
   #:parsenip)
  (:import-from #:serapeum
   #:parse-float)
  (:local-nicknames
   (:ch #:coalton/char)
   (:c #:coalton/cell)
   (:s #:coalton/string)
   )
  (:export
   ;; Parsing Text
   #:int-char?
   #:dec-char?
   #:ws-char?
   #:chars->str
   #:parse-float?
   
   #:skip-ws
   #:next-int
   #:next-ufix
   #:next-decimal
   #:literal-string
   #:switch-string
   ))

(cl:in-package #:parsenip/text)

(cl:declaim (cl:optimize (cl:speed 3) (cl:debug 0) (cl:safety 1)))

(named-readtables:in-readtable coalton:coalton)

;;;
;;; Parsing text
;;; 

(coalton-toplevel
  (inline)
  (declare int-char? (Char -> Boolean))
  (define (int-char? c)
    "Returns `True` if `c` could be part of a properly parsed integer. Includes digits,
'+', and '-'."
    (cond
      ((ch:ascii-digit? c) True)
      ((== c #\-) True)
      ((== c #\+) True)
      (True False)))

  (inline)
  (declare dec-char? (Char -> Boolean))
  (define (dec-char? c)
    "Returns `True` if `c` could be part of a properly parsed decimal. Includes digits,
'+', '-', and '.'."
    (or (int-char? c)
        (== c #\.)))

  (inline)
  (declare parse-float? (String -> Optional F64))
  (define (parse-float? s)
    (catch (Some
            (lisp (-> F64) (s)
              (parse-float s :junk-allowed cl:nil :type 'cl:double-float)))
      (_ None)))

  (inline)
  (declare ws-char? (Char -> Boolean))
  (define (ws-char? c)
    "Return True if `c` is a whitespace character. Included: space, newline, and tab."
    (match c
      (#\Space True)
      (#\Newline True)
      (#\Tab True)
      (_ False)))

  (inline)
  (declare chars->str (Vector Char -> String))
  (define (chars->str vec)
    (lisp (-> String) (vec)
      (cl:coerce vec 'cl:string)))

  (inline)
  (declare skip-ws (Source :s :c Char => Void -> Parser :s :c :r Unit))
  (define (skip-ws)
    (skip-while ws-char?))
  
  (inline)
  (declare next-int (Source :s :c Char => Void -> Parser :s :c :r Integer))
  (define (next-int)
    "Parse the next integer. Accepts + or - signs. Fails if a valid integer is not parsed."
    (flatten-opt
     (map ƒc.(s:parse-int (chars->str c))
          (many1 (next-if int-char?)))))

  (declare next-ufix-loop (Source :s :c Char => :s * :c * UFix -> :c * UFix))
  (define (next-ufix-loop s c x)
    (let (values t? c?) = (step s c))
    (match t?
      ((None)
       (values c x))
      ((Some t)
       (match (ch:digit->ufix t)
         ((None)
          (values c x))
         ((Some d)
          (match c?
            ((None)
             (values c x))
            ((Some c)
             (next-ufix-loop s c (+ (* 10 x) d)))))))))

  (inline)
  (declare next-ufix (Source :s :c Char => Void -> Parser :s :c :r UFix))
  (define (next-ufix)
    "Parse the next unsigned integer. Doesn't accept any signs. Fails if a valid integer
is not parsed."
    (Parser%
     (fn (s c0 _ on-rec on-s)
       (step-safe s c0 on-rec (t c)
         (match (ch:digit->ufix t) 
           ((None)
            (on-rec c0 "Failed to parse ufix value."))
           ((Some x)
            (let (values c x) = (next-ufix-loop s c x))
            (on-s c x)))))))

  (inline)
  (declare next-decimal (Source :s :c Char => Void -> Parser :s :c :r F64))
  (define (next-decimal)
    "Parse the next decimal number. Accepts + or - signs. Does not accept exponents."
    (flatten-opt
     (map ƒc.(parse-float? (chars->str c))
          (many1 (next-if dec-char?))))))

(defmacro literal-string (tokens a)
  "Parse the next tokens, succeeding if they match `tokens` exactly. Fails otherwise.
Returns `a` if successful.

Type: (Source :s :c Char) => String * :a -> Parser :s :c :r :a"
  `(literal ,(cl:coerce tokens 'cl:list) ,a))

(defmacro switch-string (forms)
  "Match against one or more string literal forms.

Example:
(switch-string
    ((\"123\" (pure 123))
     (\"124\" (pure 124))
     (\"321\" (parse-321))))"
  `(switch
       ,(cl:mapcar (cl:lambda (form)
                     (cl:let ((literal (cl:first form))
                              (result (cl:second form)))
                       `(,(cl:coerce literal 'cl:list) ,result)))
         forms)))
