(cl:defpackage #:parsenip
  (:use
   #:coalton
   #:coalton-prelude
   #:parsenip/sources
   ;; #:coalton/math/integral)
   )
  (:import-from #:serapeum
   #:parse-float)
  (:import-from #:coalton/experimental/loops
   #:doiter
   #:dorange
   #:dotimes)
  (:local-nicknames
   (:t #:coalton/types)
   (:l #:coalton/list)
   (:la #:coalton/lisparray)
   (:v #:coalton/vector)
   (:f #:coalton/format)
   (:fl #:coalton/file)
   (:c #:coalton/cell)
   (:s #:coalton/string)
   (:b #:coalton/bits)
   )
  (:export
   ;; Parser type
   #:ParseError
   #:Context
   #:ParseResult
   #:Parser

   ;; Combinators
   #:partial
   #:label
   #:parse-fail
   #:cut
   #:eof
   #:flatten-fail
   #:peek
   #:next
   #:next-if
   #:parse-into
   #:many
   #:many_
   #:many1
   #:skip-many
   #:sep-by
   #:sep-by1

   ;; Top-Level Runners
   #:parse-source
   #:parse-file-chars!
   ))

(cl:in-package #:parsenip)

(named-readtables:in-readtable coalton:coalton)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;            Parser Type            ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; Type variable dictionary:
;;;
;;; :s - Source type. (Vector Char), (List U8), etc.
;;; :c - Cursor type. UFix, (List U8), etc.
;;; :t - Token type. U8, Char, etc.
;;; :a - Intermediate representation.
;;; :r - Final parser output.

(coalton-toplevel
  (define-type-alias ParseError String)
  (define-type-alias Context (List ParseError))

  (define-type-alias (ParseResult :r) (Result (Tuple Context ParseError) :r))
  
  (define-type-alias (Failure :s :c :r) (:s * :c * Context * ParseError -> ParseResult :r))
  (define-type-alias (Success :s :c :r :a) (:s * :c * :a -> ParseResult :r))
  
  (repr :transparent)
  (define-type (Parser :s :c :r :a)
    "Parser that converts source `:s` using cursor `:c` to an `:a`, which is eventually
transformed to an `:r`."
    (Parser%
     ( :s ;; source
     * :c ;; active cursor
     * (Failure :s :c :r) ;; On unrecoverable failure continuation
     * (Failure :s :c :r) ;; On recoverable failure continuation
     * (Success :s :c :r :a) ;; On success continuation
     -> ParseResult :r)))
     
  (inline)
  (declare run-parser% (Parser :s :c :r :a *
                        :s * :c * (Failure :s :c :r) * (Failure :s :c :r) * (Success :s :c :r :a)
                        -> ParseResult :r))
  (define (run-parser% (Parser% f-parser) source cursor on-unrecoverable on-recoverable on-success)
    (f-parser source cursor on-unrecoverable on-recoverable on-success))
  )

;;;
;;; Core Parser Instances
;;; 

(coalton-toplevel
  (define-instance (Functor (Parser :s :c :r))
    (inline)
    (define (map f parser)
      (Parser%
       (fn (s c on-un on-rec on-s)
         (let on-s_ = ƒsca.(on-s s c (f a)))
         (run-parser% parser s c on-un on-rec on-s_)))))

  (inline)
  (declare pure% (:a -> Parser :s :c :r :a))
  (define (pure% x)
    (Parser%
     (fn (s c _on-un _on-rec on-s)
       (on-s s c x))))

  (inline)
  (declare lifta2% ((:a * :b -> :z) * Parser :s :c :r :a * Parser :s :c :r :b -> Parser :s :c :r :z))
  (define (lifta2% fa-b->c pa pb)
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% pa s c on-un on-rec
                    ƒsca.(run-parser% pb s c on-un on-rec
                                      ƒscb.(on-s s c (fa-b->c a b)))))))

  (define-instance (Applicative (Parser :s :c :r))
    (inline)
    (define (pure a)
      (pure% a))
    (inline)
    (define (lifta2 f pa pb)
      (lifta2% f pa pb)))

  (inline)
  (declare flatmap% ((:a -> Parser :s :c :r :b) * Parser :s :c :r :a -> Parser :s :c :r :b))
  (define (flatmap% fa->pb pa)
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% pa s c on-un on-rec
                    ƒsca.(run-parser% (fa->pb a)
                                      s c on-un on-rec on-s)))))

  (define-instance (Monad (Parser :s :c :r))
    (inline)
    (define (>>= pa f)
      (flatmap% f pa)))

  (define-instance (Alternative (Parser :s :c :r))
    (define empty
      (Parser%
       (fn (s c _ on-rec _)
         (on-rec s c Nil ""))))
    (inline)
    (define (alt p1 p2)
      (Parser% 
       (fn (s c on-un on-rec on-s)
         (run-parser% p1 s c on-un
                      (fn (_s _c _ctx _err)
                        (run-parser% p2 s c on-un on-rec on-s))
                      on-s)))))
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;            Parser API             ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; NOTE: Following attoparsec, parsers should always backtrack on failure.
 
;;;
;;; Combinators
;;;

(defmacro advance-n-safe (s c n on-rec (sym) cl:&body body)
  `(match (advance-n ,s ,c ,n)
     ((None)
      (,on-rec ,s ,c Nil "EOF reached."))
     ((Some ,sym)
      ,@body)))

(defmacro curse-next-safe (s c on-rec (c-sym t-sym) cl:&body body)
  `(match (curse ,s ,c)
     ((None)
      (,on-rec ,s ,c Nil "EOF reached."))
     ((Some ,t-sym)
      (advance-n-safe ,s ,c 1 ,on-rec (,c-sym)
        ,@body))))

(coalton-toplevel
  (declare partial (Parser :s :c :r :a -> Parser :s :c :r (Tuple3 :s :c :a)))
  (define (partial p)
    "Return the unparsed source and cursor with the parse result. Useful for debugging."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un on-rec
                    ƒsca.(on-s s c (Tuple3 s c a))))))
  
  (declare label (String * Parser :s :c :r :a -> Parser :s :c :r :a))
  (define (label context parser)
    "Label `parser` with `context` for error messages."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% parser s c
                    ƒscxe.(on-un s c (Cons context x) e)
                    ƒscxe.(on-rec s c (Cons context x) e)
                    on-s))))

  (declare parse-fail (String -> Parser :s :c :r :a))
  (define (parse-fail msg)
    "Raise a recoverable failure with `msg`."
    (Parser%
     (fn (s c _on-un on-rec _on-s)
       (on-rec s c Nil msg))))

  (declare cut (Source :s :c :t => Void -> Parser :s :c :r Unit))
  (define (cut)
    "Allow the source to reclaim memory upto the current cursor. After this is called, the
parser may not be able to backtrack to before the current cursor position!"
    (Parser%
     (fn (s c _on-un _on-rec on-s)
       (cut! s c)
       (on-s s c Unit))))
  
  (declare eof (Source :s :c :t => Void -> Parser :s :c :r Unit))
  (define (eof)
    "Succeed if no tokens remain, fail otherwise."
    (Parser%
     (fn (s c _ on-rec on-s)
       (match (curse s c)
         ((None)
          (on-s s c Unit))
         ((Some t)
          (on-rec s c Nil (lisp (-> String) (t)
                            (cl:format cl:nil "Expected EOF. Got: ~a" t))))))))

  (declare flatten-fail (Parser :s :c :r (Optional :t) -> Parser :s :c :r :t))
  (define (flatten-fail p)
    "Fail a `None` parse result."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un on-rec
                    (fn (s2 c2 a)
                      (match a
                        ((Some t)
                         (on-s s2 c2 t))
                        ((None)
                         (on-rec s c Nil "Unexpected None result."))))))))

  (declare peek (Source :s :c :t => Void -> Parser :s :c :r :t))
  (define (peek)
    "Look at the current token without parsing forward. Fails if no tokens remain."
    (Parser%
     (fn (s c _ on-rec on-s)
       (match (curse s c)
         ((None)
          (on-rec s c Nil "EOF reached."))
         ((Some t)
          (on-s s c t))))))
    
  (declare next (Source :s :c :t => Void -> Parser :s :c :r :t))
  (define (next)
    "Parse the current token and advance the cursor by 1. Fails if no tokens remain."
    (Parser%
     (fn (s c _ on-rec on-s)
       (curse-next-safe s c on-rec (c2 t)
         (on-s s c2 t)))))

  (declare next-if (Source :s :c :t => (:t -> Boolean) -> Parser :s :c :r :t))
  (define (next-if pred)
    "Parse the current token and advance the cursor by 1 if it satisfies `pred`, failing
if it does not."
    (Parser%
     (fn (s c _on-un on-rec on-s)
       (curse-next-safe s c on-rec (c2 t)
         (if (pred t)
             (on-s s c2 t)
             (on-rec s c Nil "Token failed to satisfy predicate."))))))

  ;; TODO: Convert this to loop or... make tail recursive jesus christ
  (declare parse-into (Accumulator :a :f => :a :t * Parser :s :c :r :t -> Parser :s :c :r (:a :t)))
  (define (parse-into acc p)
    "Run `p` until it fails, accumulating the results into `acc`."
    (Parser%
     (fn (s c on-un _on-rec on-s)
       (let acc = (c:new acc))
       (let last-successful-c = (c:new c))
       (let ((on-inner-rec
               (fn (s _ _ _)
                 (on-s s (c:read last-successful-c) (c:read acc))))
             (on-inner-s
               (fn (s c t)
                 (c:write! acc (accumulate (c:read acc) t))
                 (c:write! last-successful-c c)
                 (run-parser% p s c on-un on-inner-rec on-inner-s))))
         (run-parser% p s c on-un on-inner-rec on-inner-s)))))

  (declare many (Accumulator :a :f => Parser :s :c :r :t -> Parser :s :c :r (:f :t)))
  (define (many p)
    "Repeat `p` until it fails, returning its results."
    (let acc = (initial-accumulator))
    (map finalize (parse-into acc p)))

  (declare many_ (Parser :s :c :r :t -> Parser :s :c :r (Vector :t)))
  (define many_ many)

  (declare many1 (Accumulator :a :f => Parser :s :c :r :t -> Parser :s :c :r (:f :t)))
  (define (many1 p)
    "Repeat `p` until it fails, returning its results. Must succeed at least once."
    (do
     (t <- (label "Expected at least 1 success." p))
     (let acc = (initial-accumulator-with t))
     (map finalize (parse-into acc p))))

  ;; TODO: Convert this into a loop or tail recursive or something
  (declare skip-many (Parser :s :c :r :t -> Parser :s :c :r Unit))
  (define (skip-many p)
    "Skip successes of `p` until it fails."
    (Parser%
     (fn (s c on-un _on-rec on-s)
       (let ((on-inner-rec ƒsc__.(on-s s c Unit))
             (on-inner-s
               (fn (s c _)
                 (run-parser% p s c on-un on-inner-rec on-inner-s))))
         (run-parser% p s c on-un on-inner-rec on-inner-s)))))

  (declare sep-by (Accumulator :a :f => Parser :s :c :r :t * Parser :s :c :r :x -> Parser :s :c :r (:f :t)))
  (define (sep-by p sep)
    "Parses zero or more occurences of `p`, separated by `sep`. Returns the values
returned by `p`."
    (alt
     (sep-by1 p sep)
     (pure (finalize (initial-accumulator)))))

  (declare sep-by1 (Accumulator :a :f => Parser :s :c :r :t * Parser :s :c :r :x -> Parser :s :c :r (:f :t)))
  (define (sep-by1 p sep)
    "Parses zero or more occurences of `p`, separated by `sep`. Returns the values
returned by `p`. Must succeed at least once."
    (do
     (t <- (label "Expected at least 1 success." p))
     (let acc = (initial-accumulator-with t))
     (map finalize
          (parse-into acc
                      (do
                       sep
                       p)))))
  )

;;;
;;; Top-Level Runners
;;; 

(coalton-toplevel
  (declare parse-source (Source :s :c :t => :s * Parser :s :c :r :r -> ParseResult :r))
  (define (parse-source source parser)
    (run-parser% parser
                 source
                 (initial-cursor source)
                 ƒ__xe.(Err (Tuple x e))
                 ƒ__xe.(Err (Tuple x e))
                 ƒ__r.(Ok r)))

  (declare parse-file-chars! (fl:FileStream Char * Parser (BufferedSource Char) UFix :r :r -> ParseResult :r))
  (define (parse-file-chars! fs parser)
    "Parse `fs` using `parser`. Will consume the stream."
    (let buf = (new-buffered-source ƒ.(into (fl:read-char fs))))
    (parse-source buf parser))
  )

