(cl:defpackage #:parsenip
  (:use
   #:coalton
   #:coalton-prelude
   #:parsenip/sources
   )
  (:import-from #:serapeum
   #:parse-float)
  (:import-from #:coalton/experimental/loops
   #:dorange
   #:dotimes)
  (:local-nicknames
   (:t #:coalton/types)
   (:l #:coalton/list)
   (:la #:coalton/lisparray)
   (:v #:coalton/vector)
   (:f #:coalton/format)
   (:fl #:coalton/file)
   (:c #:coalton/cell)
   (:s #:coalton/string)
   (:b #:coalton/bits)
   (:it #:coalton/iterator)
   )
  (:export
   ;; Parser type
   #:ParseError
   #:Context
   #:ParseResult
   #:Parser

   ;; Combinators
   #:partial
   #:label
   #:parse-err
   #:parse-fail
   #:commit
   #:reclaim
   #:eof
   #:flatten-opt
   #:fails
   #:look-ahead
   #:peek
   #:next
   #:next-if
   #:next-token
   #:literal
   #:parse-into
   #:count
   #:many
   #:many_
   #:many1
   #:many-till
   #:skip-many
   #:sep-by
   #:sep-by1
   #:chainl
   #:chainl1

   ;; Top-Level Runners
   #:parse-source
   #:parse-file-chars!
   ))

(cl:in-package #:parsenip)

(cl:declaim (cl:optimize (cl:speed 3) (cl:debug 0) (cl:safety 1)))

(named-readtables:in-readtable coalton:coalton)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;            Parser Type            ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; Type variable dictionary:
;;;
;;; :s - Source type. (Vector Char), (List U8), etc.
;;; :c - Cursor type. UFix, (List U8), etc.
;;; :t - Token type. U8, Char, etc.
;;; :a - Intermediate representation.
;;; :r - Final parser output.

(coalton-toplevel
  (define-type-alias ParseError String)
  (define-type-alias Context (List ParseError))

  (define-type-alias (ParseResult :c :r) (Result (Tuple3 :c Context ParseError) :r))
  
  (define-type-alias (UnrecFailure :c :r) (:c * Context * ParseError -> ParseResult :c :r))
  (define-type-alias (RecFailure :c :r) (:c * ParseError -> ParseResult :c :r))
  (define-type-alias (Success :c :r :a) (:c * :a -> ParseResult :c :r))
  
  (repr :transparent)
  (define-type (Parser :s :c :r :a)
    "Parser that converts source `:s` using cursor `:c` to an `:a`, which is eventually
transformed to an `:r`."
    (Parser%
     ( :s ;; source
     * :c ;; active cursor
     * (UnrecFailure :c :r) ;; On unrecoverable failure continuation
     * (RecFailure :c :r)   ;; On recoverable failure continuation
     * (Success :c :r :a)   ;; On success continuation
     -> ParseResult :c :r)))
     
  (inline)
  (declare run-parser% (Parser :s :c :r :a *
                        :s * :c * (UnrecFailure :c :r) * (RecFailure :c :r) * (Success :c :r :a)
                        -> ParseResult :c :r))
  (define (run-parser% (Parser% f-parser) source cursor on-unrecoverable on-recoverable on-success)
    (f-parser source cursor on-unrecoverable on-recoverable on-success))
  )

;;;
;;; Core Parser Instances
;;; 

(coalton-toplevel
  (define-instance (Functor (Parser :s :c :r))
    (inline)
    (define (map f parser)
      (Parser%
       (fn (s c on-un on-rec on-s)
         (let on-s_ = ƒca.(on-s c (f a)))
         (run-parser% parser s c on-un on-rec on-s_)))))

  (inline)
  (declare pure% (:a -> Parser :s :c :r :a))
  (define (pure% x)
    (Parser%
     (fn (_ c _on-un _on-rec on-s)
       (on-s c x))))

  (inline)
  (declare lifta2% ((:a * :b -> :z) * Parser :s :c :r :a * Parser :s :c :r :b -> Parser :s :c :r :z))
  (define (lifta2% fa-b->c pa pb)
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% pa s c on-un on-rec
                    ƒca.(run-parser% pb s c on-un on-rec
                                      ƒcb.(on-s c (fa-b->c a b)))))))

  (define-instance (Applicative (Parser :s :c :r))
    (inline)
    (define (pure a)
      (pure% a))
    (inline)
    (define (lifta2 f pa pb)
      (lifta2% f pa pb)))

  (inline)
  (declare flatmap% ((:a -> Parser :s :c :r :b) * Parser :s :c :r :a -> Parser :s :c :r :b))
  (define (flatmap% fa->pb pa)
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% pa s c on-un on-rec
                    ƒca.(run-parser% (fa->pb a)
                                     s c on-un on-rec on-s)))))

  (define-instance (Monad (Parser :s :c :r))
    (inline)
    (define (>>= pa f)
      (flatmap% f pa)))

  (define-instance (Alternative (Parser :s :c :r))
    (define empty
      (Parser%
       (fn (s c _ on-rec _)
         (on-rec c ""))))
    (inline)
    (define (alt p1 p2)
      (Parser% 
       (fn (s c on-un on-rec on-s)
         (run-parser% p1 s c on-un
                      ƒ__.(run-parser% p2 s c on-un on-rec on-s)
                      on-s)))))
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;            Parser API             ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;
;;; Standard constant error messages
;;;

(coalton-toplevel
  (define eof-err "Unexpected EOF reached."))

 
;;;
;;; Combinators
;;;

;; NOTE: Following attoparsec, parsers should always backtrack on failure.

(defmacro step-safe (s c on-rec (t-sym c-sym) cl:&body body)
  (cl:let ((t?-sym (cl:gensym))
           (c?-sym (cl:gensym)))
    `(progn
       (let (Tuple ,t?-sym ,c?-sym) = (step ,s ,c))
       (match ,t?-sym
         ((None)
          (,on-rec ,c eof-err))
         ((Some ,t-sym)
          (match ,c?-sym
            ((None)
             (,on-rec ,c eof-err))
            ((Some ,c-sym)
             ,@body)))))))

(coalton-toplevel
  (inline)
  (declare partial (Parser :s :c :r :a -> Parser :s :c :r (Tuple :c :a)))
  (define (partial p)
    "Return the active cursor with the parse result. Useful for debugging or performing
a partial parse then resuming later."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un on-rec
                    ƒca.(on-s c (Tuple c a))))))
  
  (inline)
  (declare label (String * Parser :s :c :r :a -> Parser :s :c :r :a))
  (define (label msg parser)
    "Label `parser` with `msg` for error messages. Adds to the context of unrecoverable
errors, and replaces any existing error message for recoverable errors."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% parser s c
                    ƒcxe.(on-un c (Cons msg x) e)
                    ƒc_.(on-rec c msg)
                    on-s))))

  (inline)
  (declare parse-err (String -> Parser :s :c :r :a))
  (define (parse-err msg)
    "Raise an unrecoverable error with `msg`."
    (Parser%
     (fn (_ c on-un _ _)
       (on-un c Nil msg))))

  (inline)
  (declare parse-fail (String -> Parser :s :c :r :a))
  (define (parse-fail msg)
    "Raise a recoverable failure with `msg`."
    (Parser%
     (fn (_ c _on-un on-rec _on-s)
       (on-rec c msg))))

  (inline)
  (declare commit (Source :s :c :t => Parser :s :c :r :a -> Parser :s :c :r :a))
  (define (commit p)
    "Commit to this branch of parsing. If `p` fails, raises an unrecoverable error."
    (Parser%
     (fn (s c on-un _ on-s)
       (run-parser% p s c on-un ƒce.(on-un c Nil e) on-s))))

  (inline)
  (declare reclaim (Source :s :c :t => Void -> Parser :s :c :r Unit))
  (define (reclaim)
    "Discard source data preceding the current cursor. The caller must ensure that no
subsequent success or failure path can resume from an earlier cursor."
    (Parser%
     (fn (s c _ _ on-s)
       (reclaim! s c)
       (on-s c Unit))))
  
  (inline)
  (declare eof (Source :s :c :t => Void -> Parser :s :c :r Unit))
  (define (eof)
    "Succeed if no tokens remain, fail otherwise."
    (Parser%
     (fn (s c _ on-rec on-s)
       (match (curse s c)
         ((None)
          (on-s c Unit))
         ((Some t)
          (on-rec c (lisp (-> String) (t)
                      (cl:format cl:nil "Expected EOF. Got: ~a" t))))))))

  (inline)
  (declare flatten-opt (Parser :s :c :r (Optional :a) -> Parser :s :c :r :a))
  (define (flatten-opt p)
    "Fail a `None` parse result."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un on-rec
                    (fn (c2 a)
                      (match a
                        ((Some t)
                         (on-s c2 t))
                        ((None)
                         (on-rec c "Unexpected None result."))))))))

  (inline)
  (declare fails (Parser :s :c :r :a -> Parser :s :c :r Unit))
  (define (fails p)
    "Succeedes if `p` fails, and fails if `p` succeedes."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un
                    ƒc_.(on-s c Unit)
                    ƒ__.(on-rec c "Parser succeeded but was expected to fail.")))))

  (inline)
  (declare look-ahead (Parser :s :c :r :t -> Parser :s :c :r :t))
  (define (look-ahead p)
    "Apply `p` without advancing the cursor."
    (Parser%
     ;; NOTE: Because all parsers backtrack on failure, only needs to handle on-s
     (fn (s c on-un on-rec on-s)
       (run-parser% p s c on-un on-rec ƒ_a.(on-s c a)))))

  (inline)
  (declare peek (Source :s :c :t => Void -> Parser :s :c :r :t))
  (define (peek)
    "Look at the current token without parsing forward. Fails if no tokens remain."
    (Parser%
     (fn (s c _ on-rec on-s)
       (match (curse s c)
         ((None)
          (on-rec c "EOF reached."))
         ((Some t)
          (on-s c t))))))
    
  (inline)
  (declare next (Source :s :c :t => Void -> Parser :s :c :r :t))
  (define (next)
    "Parse the current token and advance the cursor by 1. Fails if no tokens remain."
    (Parser%
     (fn (s c _ on-rec on-s)
       (step-safe s c on-rec (t c)
         (on-s c t)))))

  (inline)
  (declare next-if (Source :s :c :t => (:t -> Boolean) -> Parser :s :c :r :t))
  (define (next-if pred)
    "Parse the current token and advance the cursor by 1 if it satisfies `pred`, failing
if it does not."
    (Parser%
     (fn (s c _on-un on-rec on-s)
       (step-safe s c on-rec (t c2)
         (if (pred t)
             (on-s c2 t)
             (on-rec c "Token failed to satisfy predicate."))))))

  (inline)
  (declare next-token ((Source :s :c :t) (Eq :t) => :t -> Parser :s :c :r :t))
  (define (next-token t)
    "Parse the current token and advance the cursor by 1 if it matches `t`, failing if it
does not."
    (next-if ƒx.(== x t)))

  (inline)
  (declare literal ((it:IntoIterator :v :t) (Source :s :c :t) (Eq :t) => :v * :a -> Parser :s :c :r :a))
  (define (literal tokens a)
    "Parse the next tokens, succeeding if they match `tokens` exactly. Fails otherwise.
Returns `a` if successful."
    (Parser%
     (fn (s c0 _on-un on-rec on-s)
       (let it = (it:into-iter tokens))
       (rec % ((c c0)
               (next-t? (it:next! it)))
         (match next-t?
           ((None)
            (on-s c a))
           ((Some next-t)
            (let (Tuple t? c?) = (step s c))
            (match t?
              ((None)
               (on-rec c0 eof-err))
              ((Some t)
               (match c?
                 ((None)
                  (on-rec c0 eof-err))
                 ((Some c)
                  (if (== t next-t)
                      (% c (it:next! it))
                      (on-rec c0 "Unexpected token in literal."))))))))))))

  (inline)
  (declare parse-into (Accumulator :v :f => :v :a * Parser :s :c :r :a -> Parser :s :c :r (:v :a)))
  (define (parse-into acc p)
    "Run `p` until it fails, accumulating the results into `acc`."
    (Parser%
     (fn (s c on-un _on-rec on-s)
       (let last-successful-c = (c:new c))
       (let ((on-inner-rec
               (fn (_ _)
                 (on-s (c:read last-successful-c) acc)))
             (on-inner-s
               (fn (c t)
                 (accumulate! acc t)
                 (c:write! last-successful-c c)
                 (run-parser% p s c on-un on-inner-rec on-inner-s))))
         (run-parser% p s c on-un on-inner-rec on-inner-s)))))

  (inline)
  (declare count (Accumulator :v :f => UFix * Parser :s :c :r :a -> Parser :s :c :r (:f :a)))
  (define (count n p)
    "Run `p` `n` times, accumulating every result. Fails if any application of `p` fails."
    (Parser%
     (fn (s c0 on-un on-rec on-s)
       (let acc = (initial-accumulator))
       (if (zero? n)
           (on-s c0 (finalize acc))
           (let ((i (c:new n))
                 (on-inner-s
                   (fn (c a)
                     (accumulate! acc a)
                     (if (zero? (c:decrement! i))
                         (on-s c (finalize acc))
                         (run-parser% p s c on-un ƒ_e.(on-rec c0 e) on-inner-s)))))
             (run-parser% p s c0 on-un on-rec on-inner-s))))))

  (inline)
  (declare many (Accumulator :v :f => Parser :s :c :r :a -> Parser :s :c :r (:f :a)))
  (define (many p)
    "Repeat `p` until it fails, returning its results."
    (let acc = (initial-accumulator))
    (map finalize (parse-into acc p)))

  (inline)
  (declare many_ (Parser :s :c :r :t -> Parser :s :c :r (Vector :t)))
  (define many_ many)

  (inline)
  (declare many1 (Accumulator :v :f => Parser :s :c :r :a -> Parser :s :c :r (:f :a)))
  (define (many1 p)
    "Repeat `p` until it fails, returning its results. Must succeed at least once."
    (do
     (t <- (label "Expected at least 1 success." p))
     (let acc = (initial-accumulator))
     ;; TODO: Don't do this at home
     (let _ = (accumulate! acc t))
     (map finalize (parse-into acc p))))

  (inline)
  (declare many-till (Accumulator :v :f => Parser :s :c :r :a * Parser :s :c :r :b -> Parser :s :c :r (:f :a)))
  (define (many-till p end)
    "Repeat `p` zero or more times until `end` succeedes, returning the results. If `p`
fails at all, `many-till` fails and backtracks."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (let acc = (initial-accumulator))
       (let ((on-inner-rec-end
               (fn (c _)
                 (run-parser% p s c on-un on-rec on-inner-s-p)))
             (on-inner-s-end
               (fn (c _)
                 (on-s c (finalize acc))))
             (on-inner-s-p
               (fn (c a)
                 (accumulate! acc a)
                 (run-parser% end s c on-un on-inner-rec-end on-inner-s-end))))
         (run-parser% end s c on-un on-inner-rec-end on-inner-s-end)))))

  (inline)
  (declare skip-many (Parser :s :c :r :t -> Parser :s :c :r Unit))
  (define (skip-many p)
    "Skip successes of `p` until it fails."
    (Parser%
     (fn (s c on-un _on-rec on-s)
       (let ((on-inner-rec ƒc_.(on-s c Unit))
             (on-inner-s
               (fn (c _)
                 (run-parser% p s c on-un on-inner-rec on-inner-s))))
         (run-parser% p s c on-un on-inner-rec on-inner-s)))))

  (inline)
  (declare sep-by (Accumulator :a :f => Parser :s :c :r :t * Parser :s :c :r :x -> Parser :s :c :r (:f :t)))
  (define (sep-by p sep)
    "Parses zero or more occurences of `p`, separated by `sep`. Returns the values
returned by `p`."
    (alt
     (sep-by1 p sep)
     (pure (finalize (initial-accumulator)))))

  (inline)
  (declare sep-by1 (Accumulator :v :f => Parser :s :c :r :a * Parser :s :c :r :x -> Parser :s :c :r (:f :a)))
  (define (sep-by1 p sep)
    "Parses zero or more occurences of `p`, separated by `sep`. Returns the values
returned by `p`. Must succeed at least once."
    (do
     (t <- (label "Expected at least 1 success." p))
     (let acc = (initial-accumulator))
     ;; TODO: Don't do this at home
     (let _ = (accumulate! acc t))
     (map finalize
          (parse-into acc
                      (do
                       sep
                       p)))))

  (inline)
  (declare chainl (Parser :s :c :r :a * Parser :s :c :r (:a * :a -> :a) * :a -> Parser :s :c :r :a))
  (define (chainl p op a)
    "Parse zero or more occurences of `p`, separated by `op`. Returns a value obtained
by a left associative application of all functions returned by `op` to the values
returned by `p`.

The parser fails if `p` fails, and terminates when `op` fails."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (let ((on-term-suc
               (fn (c term1)
                 (let ((on-op-s
                         (fn (c op)
                           (run-parser% p s c on-un on-rec
                                        ƒct.(on-term-suc c (op term1 t))))))
                   (run-parser% op s c on-un
                                ƒc_.(on-s c term1)
                                ƒco.(on-op-s c o))))))
         (on-term-suc c a)))))

  (inline)
  (declare chainl1 (Parser :s :c :r :a * Parser :s :c :r (:a * :a -> :a) -> Parser :s :c :r :a))
  (define (chainl1 p op)
    "Parse one or more occurrences of `p`, separated by `op`. Returns a value obtained
by a left associative application of all functions returned by `op` to the values
returned by `p`.

The parser fails if `p` fails, and terminates when `op` fails."
    (Parser%
     (fn (s c on-un on-rec on-s)
       (let ((on-term-suc
               (fn (c term1)
                 (let ((on-op-s
                         (fn (c op)
                           (run-parser% p s c on-un on-rec
                                        ƒct.(on-term-suc c (op term1 t))))))
                   (run-parser% op s c on-un
                                ƒc_.(on-s c term1)
                                ƒco.(on-op-s c o))))))
         (run-parser% p s c on-un on-rec on-term-suc)))))
  )

;;;
;;; Top-Level Runners
;;; 

(coalton-toplevel
  (inline)
  (declare parse-source (Source :s :c :t => :s * Parser :s :c :r :r -> ParseResult :c :r))
  (define (parse-source source parser)
    (run-parser% parser
                 source
                 (initial-cursor source)
                 ƒcxe.(Err (Tuple3 c x e))
                 ƒce.(Err (Tuple3 c Nil e))
                 ƒ_r.(Ok r)))

  (inline)
  (declare parse-file-chars! (fl:FileStream Char * Parser (BufferedSource Char) UFix :r :r -> ParseResult UFix :r))
  (define (parse-file-chars! fs parser)
    "Parse `fs` using `parser`. Will consume the stream."
    (let buf = (new-buffered-source ƒ.(into (fl:read-char fs))))
    (parse-source buf parser))
  )
