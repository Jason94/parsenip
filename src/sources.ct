(cl:defpackage #:parsenip/sources
  (:use
   #:coalton
   #:coalton-prelude)
  ;; (:import-from #:serapeum
  ;;  #:parse-float)
  (:import-from #:coalton/experimental/loops
   ;; #:doiter
   #:dorange
   #:dotimes)
  (:local-nicknames
   (:t #:coalton/types)
   (:l #:coalton/list)
   (:la #:coalton/lisparray)
   (:v #:coalton/vector)
   ;; (:f #:coalton/format)
   ;; (:fl #:coalton/file)
   (:c #:coalton/cell)
   (:s #:coalton/string)
   (:b #:coalton/bits)
   )
  (:export
   ;; BufferedSource
   #:BufferedSource
   #:new-buffered-source

   ;; Source
   #:Source
   #:initial-cursor
   #:advance-n
   #:curse
   #:reclaim!

   ;; Accumulator
   #:Accumulator
   #:initial-accumulator
   #:initial-accumulator-with
   #:accumulate
   #:finalize
   ))

(cl:in-package #:parsenip/sources)

(named-readtables:in-readtable coalton:coalton)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;          Buffered Source          ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;
;;; Expandable Circular Buffer data structure
;;; 

(coalton-toplevel
  (define-struct (CircularBuffer :a)
    "Circular buffer that represents a slice of an infinite array. Head and tail track the
current logical slice of the infinite array stored in the buffer."
    (head (c:Cell UFix))
    (tail (c:Cell UFix))
    (offset (c:Cell UFix))
    (buffer (c:Cell (la:LispArray :a)))
    (length-log2 (c:Cell UFix)))

  (declare new-circular-buffer (forall (:a) t:RuntimeRepr :a
                                => &key (:initial-capacity UFix) -> CircularBuffer :a))
  (define (new-circular-buffer &key (initial-capacity 1024))
    "Note: initial-capacity MUST be a power of 2."
    (let element-type = (t:runtime-repr (the (t:Proxy :a) t:Proxy)))
    (let buffer =
      (lisp (-> la:LispArray :a) (initial-capacity element-type)
        (cl:make-array initial-capacity :element-type element-type)))
    (CircularBuffer
     (c:new 0)
     (c:new 0)
     (c:new 0)
     (c:new buffer)
     (c:new (1- (lisp (-> UFix) (initial-capacity)
                  (cl:integer-length initial-capacity))))))

  (inline)
  (declare %physical-index (CircularBuffer :a * UFix -> UFix))
  (define (%physical-index cbuffer i)
    (b:ldb (c:read (.length-log2 cbuffer)) 0 (- i (c:read (.offset cbuffer)))))

  (inline)
  (declare at# (CircularBuffer :a * UFix -> :a))
  (define (at# cbuffer i)
    "Get element `i` in `cbuffer` with no bounds checking."
    (la:aref (c:read (.buffer cbuffer))
             (%physical-index cbuffer i)))

  (declare %expand (CircularBuffer :a -> Void))
  (define (%expand cbuffer)
    "Expand a circular buffer by a single power of 2. Sets the current logical head to
physical index 0 in the new buffer."
    (let old-buffer = (c:read (.buffer cbuffer)))
    (let old-length = (la:length old-buffer))
    (let new-length = (* 2 old-length))
    (let new-length-log2 = (1+ (c:read (.length-log2 cbuffer))))
    (let new-buffer =
      (lisp (-> la:LispArray :a) (new-length)
        (cl:make-array new-length)))
    (let new-offset = (c:read (.head cbuffer)))
    (dorange (i (c:read (.head cbuffer)) (c:read (.tail cbuffer)))
      (la:set! new-buffer (- i new-offset) (at# cbuffer i)))
    (c:write! (.offset cbuffer) (c:read (.head cbuffer)))
    (c:write! (.buffer cbuffer) new-buffer)
    (c:write! (.length-log2 cbuffer) new-length-log2)
    (values))

  (inline)
  (declare set# (CircularBuffer :a * UFix * :a -> Void))
  (define (set# cbuffer i elt)
    "Set `i` in `cbuffer` to `elt`. Does no bounds checking."
    (la:set! (c:read (.buffer cbuffer))
             (%physical-index cbuffer i)
             elt))

  (declare set (CircularBuffer :a * UFix * :a -> Boolean))
  (define (set cbuffer i elt)
    "Attempt to set `i` in `cbuffer` to `elt`. Fails and returns `false` if `i` is out of
bounds."
    (if (or (< i (c:read (.head cbuffer)))
            (>= i (c:read (.tail cbuffer))))
        False
        (progn
          (set# cbuffer i elt)
          True)))

  (declare push (CircularBuffer :a * :a -> Void))
  (define (push cbuffer elt)
    "Push `elt` onto the end of `cbuffer`, expanding if necessary."
    (when (== (la:length (c:read (.buffer cbuffer)))
              (- (c:read (.tail cbuffer)) (c:read (.head cbuffer))))
      (%expand cbuffer))
    (set# cbuffer (c:read (.tail cbuffer)) elt)
    (c:increment! (.tail cbuffer))
    (values))

  (declare reclaim-upto (CircularBuffer :a * UFix -> Boolean))
  (define (reclaim-upto cbuffer pos)
    "Try to reclaim logical positions up to `pos`. Retains `pos` in the buffer. Returns
`False` if out of bounds."
    (cond
      ((> pos (c:read (.tail cbuffer)))
       False)
      ((< pos (c:read (.head cbuffer)))
       False)
      (True
       (c:write! (.head cbuffer) pos)
       True)))
  )

;;;
;;; Buffered Source
;;; 

(coalton-toplevel
  (define-struct (BufferedSource :a)
    (buffer (CircularBuffer :a))
    (fill (Void -> Optional :a)))

  (declare new-buffered-source (t:RuntimeRepr :a => (Void -> Optional :a) -> BufferedSource :a))
  (define (new-buffered-source fill)
    (BufferedSource
     (new-circular-buffer)
     fill))

  (declare fill-until% (BufferedSource :a * UFix -> Boolean))
  (define (fill-until% s tail)
    "Fill the buffered source until it reaches `tail`. Returns `False` if it failed to
fill enough values to reach `tail`."
    (let diff = (- (1+ tail) (c:read (.tail (.buffer s)))))
    (when (> diff 0)
      (dotimes (_ diff)
        (match ((.fill s))
          ((None)
           (return False))
          ((Some x)
           (push (.buffer s) x)))))
    True)

  (declare at-bs% (BufferedSource :a * UFix -> Optional :a))
  (define (at-bs% s i)
    (let buf = (.buffer s))
    (cond
      ((< i (c:read (.head buf)))
       None)
      ((>= i (c:read (.tail buf)))
       (if (fill-until% s i)
           (Some (at# buf i))
           None))
      (True
       (Some (at# buf i))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;         Source & Cursor           ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(coalton-toplevel
  (define-class (Source :s :c :t (:s -> :c :t))
    (initial-cursor
     "Cursor pointing to the beginning of `source`."
     (:s -> :c))
    (advance-n
     "Attempt to advance `cursor` by `n`. Returns `None` if EOF."
     (:s * :c * UFix -> Optional :c))
    (curse
     "Attempt to get the value at `cursor` in `source`. Returns `None` if EOF."
     (:s * :c -> Optional :t))
    (reclaim!
     "Signal that the parser will never backtrack before `cursor`. Is allowed to mutate
the source, such that any curses to `cursor` or later will not be affected. Allows
reclamation of memory for unbounded sources."
     (:s * :c -> Void))))

;;;
;;; Source Instances
;;;

(coalton-toplevel
  (define-instance (Source (List :t) (List :t) :t)
    (define initial-cursor id)
    (inline)
    (define (advance-n _ lst n)
      (rec % ((n n)
              (rem lst))
        (if (zero? n)
            (Some rem)
            (match rem
              ((Nil)
               None)
              ((Cons _ tail)
               (% (1- n) tail))))))
    (inline)
    (define (curse _ lst)
      (l:head lst))
    (inline)
    (define (reclaim! _ _)
      (values))))

(coalton-toplevel
  (define-instance (Source (Vector :t) UFix :t)
    (inline)
    (define (initial-cursor _)
      0)
    (inline)
    (define (advance-n vec i n)
      (let next = (+ i n))
      ;; > instead of >= because EOF must be a valid cursor position.
      (if (> next (v:length vec))
          None
          (Some next)))
    (inline)
    (define (curse vec i)
      (v:index i vec))
    (inline)
    (define (reclaim! _ _)
      (values))))

(coalton-toplevel
  (define-instance (Source String UFix Char)
    (inline)
    (define (initial-cursor _)
      0)
    (inline)
    (define (advance-n s i n)
      (let next = (+ i n))
      (if (> next (s:length s))
          None
          (Some next)))
    (inline)
    (define (curse s i)
      (s:ref s i))
    (inline)
    (define (reclaim! _ _)
      (values))))

(coalton-toplevel
  (define-instance (Source (BufferedSource :t) UFix :t)
    (inline)
    (define (initial-cursor _)
      0)
    (inline)
    (define (advance-n s i n)
      (let next = (+ i n))
      (if (fill-until% s (1- next))
          (Some next)
          None))
    (inline)
    (define (curse s i)
      (at-bs% s i))
    (inline)
    (define (reclaim! s c)
      (reclaim-upto (.buffer s) c)
      (values))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;           Accumulator             ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(coalton-toplevel
  (define-class (Accumulator :a :f (:a -> :f) (:f -> :a))
    "A type that can accumulate values and then finalize the accumulation. Is allowed to
mutate internally."
    (initial-accumulator (&key (:initial (Optional (:a :t))) -> :a :t))
    (initial-accumulator-with (:t -> :a :t))
    (accumulate (:a :t * :t -> :a :t))
    (finalize (:a :t -> :f :t))))

(coalton-toplevel
  (define-instance (Accumulator List List)
    (inline)
    (define (initial-accumulator &key (initial None)) 
      (match initial
        ((Some lst)
         lst)
        ((None)
         Nil)))
    (inline)
    (define (initial-accumulator-with init)
      [init])
    (inline)
    (define (accumulate lst t)
      (Cons t lst))
    (define finalize reverse))

  ;; TODO: Add a FrozenVector type or something
  (define-instance (Accumulator Vector Vector)
    (inline)
    (define (initial-accumulator &key (initial None))
      (match initial
        ((None)
         (v:new))
        ((Some vec)
         (v:copy vec))))
    (inline)
    (define (initial-accumulator-with init)
      [init])      
    (inline)
    (define (accumulate vec t)
      (v:push! t vec)
      vec)
    (define finalize id)))
